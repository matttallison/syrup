; IrDA SIR transmitter: 8N1 frames, each 0 bit is a light pulse 3/16 of a bit long, 1 bits are dark.
; The state machine runs at 16 cycles per bit (115200 baud -> 1.8432 MHz).
; The C side pushes 10-bit frames: start (0), 8 data bits LSB first, stop (1).
.program irda_tx
top:
.wrap_target
    pull block
    set x, 9
bitloop:
    out y, 1
    jmp !y pulse
    jmp x-- bitloop [13]     ; a 1: dark for the whole bit (1 + 1 + 14 = 16 cycles)
    jmp top                  ; the stop bit always ends here
pulse:
    set pins, 1 [2]          ; a 0: LED on for 3 cycles = 3/16 of a bit
    set pins, 0
    jmp x-- bitloop [9]      ; 1 + 1 + 3 + 1 + 10 = 16 cycles
.wrap

% c-sdk {
static inline void irda_tx_init(PIO pio, uint sm, uint offset, uint pin, uint baud) {
    pio_sm_config c = irda_tx_program_get_default_config(offset);
    sm_config_set_set_pins(&c, pin, 1);
    sm_config_set_out_shift(&c, true, false, 32);
    sm_config_set_fifo_join(&c, PIO_FIFO_JOIN_TX);
    sm_config_set_clkdiv(&c, (float)clock_get_hz(clk_sys) / (16.0f * baud));
    pio_gpio_init(pio, pin);
    pio_sm_set_pins_with_mask(pio, sm, 0, 1u << pin);
    pio_sm_set_consecutive_pindirs(pio, sm, pin, 1, true);
    pio_sm_init(pio, sm, offset, &c);
    pio_sm_set_enabled(pio, sm, true);
}
static inline void irda_tx_byte(PIO pio, uint sm, uint8_t b) {
    pio_sm_put_blocking(pio, sm, (1u << 9) | ((uint32_t)b << 1));   // stop | data | start(0)
}
%}
